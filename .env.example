# Supabase ------------------------------------------------------------
# From Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) ------------------------------------------------------
# From https://resend.com → API Keys. If blank, emails are logged to the
# server console in dev and skipped in production (bookings still save).
RESEND_API_KEY=
# Optional: a verified from-address on a domain you own in Resend.
# Until verified, Resend only allows onboarding@resend.dev.
RESEND_FROM_EMAIL=

# Inbox that receives new-booking + contact-form notifications.
ADMIN_EMAIL=mazherkhan.2415@gmail.com

# Maps (optional) -----------------------------------------------------
# Google Maps JavaScript API key (enable "Maps JavaScript API" + "Places API").
# When set, the booking form gets address autocomplete + a map preview.
# When blank, the form falls back to a plain address field with a
# Bangalore-locality suggestion list — no error either way.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Business info (public, baked into HTML) -----------------------------
NEXT_PUBLIC_BUSINESS_NAME=EasyShiftX
# E.164 format with spaces is fine for display.
NEXT_PUBLIC_BUSINESS_PHONE=+91 90605 33477
# WhatsApp number: country code + number, digits only.
NEXT_PUBLIC_BUSINESS_WHATSAPP=919060533477
# Public contact inbox shown on the site.
NEXT_PUBLIC_BUSINESS_EMAIL=mazherkhan.2415@gmail.com
# Public site URL (used for OG tags and sitemap)
NEXT_PUBLIC_SITE_URL=https://packersandmovers-phi.vercel.app
