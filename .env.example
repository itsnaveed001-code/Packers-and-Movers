# Supabase ------------------------------------------------------------
# From Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Brevo) -------------------------------------------------------
# Primary provider. From Brevo → SMTP & API → API Keys (starts "xkeysib-").
# A base64-wrapped {"api_key":"..."} value also works — the app unwraps it.
# If blank, emails are logged in dev and skipped in production (bookings
# still save to the database either way).
# IMPORTANT: In Brevo → Security, turn OFF "Authorized IPs". Vercel's egress
# IPs are dynamic and can't be allowlisted, so leaving it on causes 401s.
BREVO_API_KEY=
# "From" address — MUST be a verified sender in Brevo (Senders). Defaults to
# NEXT_PUBLIC_BUSINESS_EMAIL when blank.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Numeric id of the Brevo transactional template for the admin "new booking"
# email (Brevo → Transactional → Templates → the # shown next to it). When
# blank, the admin email falls back to the built-in HTML layout.
BREVO_ADMIN_TEMPLATE_ID=
# Brevo template id for the customer-facing invoice email. Params:
# REFERENCE, SERVICE, DATE, TIME, CUSTOMER_NAME, TOTAL, LINE_ITEMS_HTML,
# NOTES, PAY_URL. Blank → inline HTML fallback.
BREVO_INVOICE_TEMPLATE_ID=

# Email (Resend) — optional fallback ----------------------------------
# Only used when BREVO_API_KEY is blank. From https://resend.com → API Keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Inbox that receives new-booking + contact-form notifications.
ADMIN_EMAIL=easyshiftx.2415@gmail.com

# Maps (optional) -----------------------------------------------------
# Google Maps JavaScript API key (enable "Maps JavaScript API" + "Places API").
# When set, the booking form gets address autocomplete + a map preview.
# When blank, the form falls back to a plain address field with a
# Bangalore-locality suggestion list — no error either way.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Business info (public, baked into HTML) -----------------------------
NEXT_PUBLIC_BUSINESS_NAME=EasyShiftX
# E.164 format with spaces is fine for display.
NEXT_PUBLIC_BUSINESS_PHONE=+91 78927 73770
# WhatsApp number: country code + number, digits only.
NEXT_PUBLIC_BUSINESS_WHATSAPP=917892773770
# Public contact inbox shown on the site.
NEXT_PUBLIC_BUSINESS_EMAIL=easyshiftx.2415@gmail.com
# Public site URL — used for canonical tags, OG/Twitter URLs, JSON-LD, sitemap.
# MUST match the production domain. Set this in Vercel (Production) too.
NEXT_PUBLIC_SITE_URL=https://easyshiftx.vercel.app
