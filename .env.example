# Supabase ------------------------------------------------------------
# From Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Brevo) -------------------------------------------------------
# Primary provider. From Brevo → SMTP & API → API Keys (starts "xkeysib-").
# A base64-wrapped {"api_key":"..."} value also works — the app unwraps it.
# If blank, emails are logged to the server console in dev and skipped in
# production (bookings still save to the database either way).
BREVO_API_KEY=
# The "from" address. MUST be a verified sender in your Brevo account
# (Brevo → Senders). Defaults to NEXT_PUBLIC_BUSINESS_EMAIL if left blank.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Email (Resend) — optional fallback ----------------------------------
# Only used when BREVO_API_KEY is blank. From https://resend.com → API Keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Where admin booking + contact-form notifications are sent.
ADMIN_EMAIL=

# Business info (public, baked into HTML) -----------------------------
NEXT_PUBLIC_BUSINESS_NAME=Packers Go Movers
# E.164 format with spaces is fine for display.
NEXT_PUBLIC_BUSINESS_PHONE=+91 98765 43210
# WhatsApp number: country code + number, digits only.
NEXT_PUBLIC_BUSINESS_WHATSAPP=919876543210
# Public site URL (used for OG tags and sitemap)
NEXT_PUBLIC_SITE_URL=https://packersgomovers.com
