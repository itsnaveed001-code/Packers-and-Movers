# Supabase ------------------------------------------------------------
# From Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) ------------------------------------------------------
# From https://resend.com → API Keys
RESEND_API_KEY=
# Optional: defaults to "Packers Go Movers <noreply@packersgomovers.com>"
# Set this to a from-address on a domain you've verified in Resend.
RESEND_FROM_EMAIL=

# Where admin booking notifications are sent.
ADMIN_EMAIL=

# Business info (public, baked into HTML) -----------------------------
NEXT_PUBLIC_BUSINESS_NAME=Packers Go Movers
# E.164 format with spaces is fine for display.
NEXT_PUBLIC_BUSINESS_PHONE=+91 98765 43210
# WhatsApp number: country code + number, digits only.
NEXT_PUBLIC_BUSINESS_WHATSAPP=919876543210
# Public site URL (used for OG tags and sitemap)
NEXT_PUBLIC_SITE_URL=https://packersgomovers.com
